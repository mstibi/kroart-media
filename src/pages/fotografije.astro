---
import Base from '../layouts/Base.astro';
import GalleryPage from '../components/GalleryPage.astro';
import { photos } from '../data/work';
---
<Base title="Fotografije: koncerti, portreti i prostori | KroArt Media" description="Fotografije koncerata, portreta i prostora: Jelena Rozga, Jale, Zmajo, Groom Room i drugi. Snimio KroArt Media iz Osijeka.">
  <GalleryPage slug="fotografije" kind="photo" items={photos}
    intro="Koncerti, portreti i prostori. Snimamo u mraku, u dimu i pod reflektorima, i predajemo fotke spremne za objavu." />
</Base>
