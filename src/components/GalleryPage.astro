---
import { Picture, getImage } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import Timeline from './Timeline.astro';
import type { Item, VideoItem } from '../data/work';
import { sections, covers } from '../data/work';

interface Props {
  slug: 'fotografije' | 'videi' | 'vizuali';
  intro: string;
  items: (Item | VideoItem)[];
  kind: 'photo' | 'visual' | 'video';
}
const { slug, intro, items, kind } = Astro.props;
const section = sections.find((s) => s.slug === slug)!;
const nextSection = sections[(sections.indexOf(section) + 1) % sections.length];
const cover = items.find((it) => it.slug === covers[slug]) ?? items[0];

const prepared = await Promise.all(items.map(async (it) => ({
  ...it,
  full: (await getImage({ src: it.src, width: Math.min(2000, it.src.width), format: 'webp' })).src,
})));
// fotke i videi zadržavaju svoj redoslijed (grupe i boje); kod vizuala naslovnu stavljamo na kraj
const gridItems = kind === 'visual' ? [...prepared.filter((it) => it.slug !== cover.slug), ...prepared.filter((it) => it.slug === cover.slug)] : prepared;
const sizes = {
  photo: '(max-width: 640px) 50vw, (max-width: 1100px) 33vw, 420px',
  visual: '(max-width: 640px) 50vw, (max-width: 1100px) 33vw, 310px',
  video: '(max-width: 640px) 100vw, 420px',
}[kind];
---
<section class="g-head wrap">
  <div class="g-cover" transition:name={`cover-${slug}`}>
    <Picture src={cover.src} alt="" formats={['avif', 'webp']} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="g-cover-img" />
  </div>
  <div class="g-meta">
    <a href="/#projekti" class="back">Svi radovi</a>
    <h1 class="display g-title" transition:name={`title-${slug}`}>{section.title}</h1>
    <p class="g-intro">{intro}</p>
    <nav class="g-nav" aria-label="Vrsta radova">
      {sections.map((s) => <a href={`/${s.slug}/`} aria-current={s.slug === slug ? 'page' : undefined}>{s.title}<span class="tc">{s.count}</span></a>)}
  </div>
</section>

<section class={`grid grid-${kind} wrap`} aria-label={`${section.title}, ${items.length} radova`}>
  <div class="gi">
  {gridItems.map((it) => {
    const v = it as VideoItem;
    const label = 'title' in it ? v.title : it.alt;
    const inner = (
      <>
        <Picture src={it.src} alt={it.alt} formats={['avif', 'webp']} widths={[400, 700, 1000]} {sizes} class="g-img" />
        {v.preview && <video class="g-prev" src={v.preview} muted loop playsinline preload="none" aria-hidden="true"></video>}
        {kind === 'video' && (!v.href || v.embed) && (
          <span class="g-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
          </span>
        )}
        {v.embed && <span class="g-plat" aria-hidden="true">{v.platform}</span>}
        {v.href && !v.embed && (
          <span class="g-ext-badge" aria-hidden="true">
            {v.platform}
            <svg viewBox="0 0 12 12" width="10" height="10"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        )}
      </>
    );
    return (
      <div class="cell" style={kind === 'photo' ? `--span: ${Math.round(24 * it.src.height / it.src.width + 0.7)}` : undefined}>
        {v.href && !v.embed ? (
          // vanjski video se otvara na platformi, bez njihovog teškog embeda na našoj stranici
          <a class="g-item g-ext" href={v.href} target="_blank" rel="noopener" aria-label={`${label}: pogledaj na ${v.platform}u (otvara se u novoj kartici)`}>{inner}</a>
        ) : (
          <button
            class="g-item" type="button"
            data-full={it.full} data-w={v.embed ? 1080 : it.src.width} data-h={v.embed ? 1920 : it.src.height} data-alt={'title' in it ? `${v.title}. ${it.alt}` : it.alt}
            data-kind={v.embed ? 'embed' : kind === 'video' ? 'video' : 'image'}
            data-video={v.video}
            data-embed={v.embed}
            data-href={v.embed ? v.href : undefined}
            data-platform={v.embed ? v.platform : undefined}
            aria-label={`Otvori: ${label}`}
          >{inner}</button>
        )}
        {'title' in it && (
          <p class="g-cap"><span class="g-cap-t">{v.title}</span><span class="g-cap-n">{v.note}</span></p>
        )}
      </div>
    );
  })}
  </div>
</section>

<a href={`/${nextSection.slug}/`} class="next wrap">
  <span class="next-label">Dalje</span>
  <span class="next-title display">{nextSection.title}</span>
</a>

<Lightbox />
<Timeline />

<style>
  .g-head { padding-top: 88px; }
  .g-cover {
    position: relative; height: clamp(260px, 46svh, 520px);
    border-radius: var(--r-panel); overflow: hidden;
    background: var(--graphite);
  }
  .g-cover :global(picture), .g-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .g-cover::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0) 50%); }
  .g-meta { display: grid; gap: 0.75rem; padding: 2rem 0 2.5rem; }
  .back {
    font-size: var(--t-xs); color: var(--ash); width: fit-content;
    transition: color 0.3s;
  }
  .back:hover { color: var(--white); }
  .g-title { font-size: var(--t-3xl); color: var(--white); width: fit-content; }
  .g-intro { max-width: 52ch; color: var(--bone); opacity: 0.8; }
  .g-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .g-nav a { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 44px; padding: 0.55rem 1rem; border: 1px solid var(--line); border-radius: 999px; font-size: var(--t-xs); color: var(--ash); }
  .g-nav a:hover { color: var(--white); border-color: var(--ash); }
  .g-nav a[aria-current] { background: var(--bone); color: var(--ink); border-color: transparent; }
  .g-nav span { font-size: 0.7rem; opacity: 0.7; }

  .grid { --gap: 12px; padding-bottom: 4rem; }
  /* fotke: masonry koji se čita red po red (redoslijed grupa i boja ostaje vidljiv).
     Svaka ćelija zauzima onoliko redova koliko joj treba po omjeru slike; jedinica reda = 1/24 širine stupca. */
  .grid-photo { --cols: 3; container-type: inline-size; }
  .grid-photo .gi {
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gap);
    grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols) / 24);
    grid-auto-flow: row dense;
  }
  .grid-photo .cell { grid-row: span var(--span); display: flex; padding-bottom: var(--gap); }
  .grid-photo .g-item { flex: 1; }
  .grid-photo .g-item :global(picture) { height: 100%; }
  .grid-photo .g-img { height: 100%; object-fit: cover; }
  .grid-visual .gi { columns: 4 220px; column-gap: var(--gap); }
  .grid-visual .cell { break-inside: avoid; margin-bottom: var(--gap); }
  .grid-video .gi { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 2rem var(--gap); }

  .g-item {
    position: relative; display: block; width: 100%;
    border-radius: var(--r-img); overflow: hidden;
    background: var(--graphite);
    cursor: zoom-in;
  }
  .grid-video .g-item { aspect-ratio: 9 / 16; cursor: pointer; }
  .g-item :global(picture) { display: block; }
  .g-img {
    width: 100%; height: auto;
    transition: transform 1s var(--ease-out), opacity 0.8s var(--ease-out), filter 0.6s;
  }
  .grid-video .g-img, .g-prev { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .g-item.is-loading .g-img { opacity: 0; }
  .g-item:hover .g-img { transform: scale(1.025); }
  .g-prev { opacity: 0; transition: opacity 0.5s var(--ease-out); }
  .g-prev.is-playing { opacity: 1; }
  .g-play {
    position: absolute; left: 14px; bottom: 14px;
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px;
    background: rgba(255,255,255,.92); color: var(--ink);
    transition: transform 0.5s var(--ease-out);
  }
  .g-item:hover .g-play { transform: scale(1.1); }
  .g-ext { cursor: pointer; }
  .g-plat {
    position: absolute; top: 12px; left: 12px;
    padding: 0.3rem 0.65rem; border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    font-size: 0.72rem; font-weight: 600; color: var(--white);
  }
  .g-ext-badge {
    position: absolute; left: 14px; bottom: 14px;
    display: inline-flex; align-items: center; gap: 0.4rem;
    height: 34px; padding: 0 0.85rem; border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    font-size: var(--t-xs); font-weight: 600; color: var(--white);
    transition: background-color 0.4s var(--ease-out);
  }
  .g-ext-badge svg { transition: transform 0.5s var(--ease-out); }
  .g-ext:hover .g-ext-badge { background: rgba(0, 0, 0, 0.75); }
  .g-ext:hover .g-ext-badge svg { transform: translate(2px, -2px); }
  .g-cap { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.9rem 0.25rem 0; line-height: 1.4; }
  .g-cap-t { font-weight: 600; color: var(--white); }
  .g-cap-n { font-size: var(--t-xs); color: var(--ash); }

  .next {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding-block: 3rem 5rem;
    border-top: 1px solid var(--line);
  }
  .next-label { font-size: var(--t-xs); color: var(--ash); }
  .next-title {
    font-size: var(--t-3xl); color: var(--bone); width: fit-content;
    transition: color 0.4s, transform 0.7s var(--ease-out);
  }
  .next:hover .next-title { color: var(--white); transform: translateX(12px); }

  @media (max-width: 640px) {
    .grid-photo { --cols: 2; --gap: 8px; }
    .grid-visual .gi { columns: 2; }
    .grid-visual { --gap: 8px; }
  }
</style>

<script>
  function grid() {
    // sličice se pojavljuju tek kad se učitaju, bez bljeska praznih kutija
    document.querySelectorAll<HTMLElement>('.g-item').forEach((it) => {
      const img = it.querySelector('img');
      if (img && !img.complete) {
        it.classList.add('is-loading');
        img.addEventListener('load', () => it.classList.remove('is-loading'), { once: true });
        img.addEventListener('error', () => it.classList.remove('is-loading'), { once: true });
      }
      const prev = it.querySelector<HTMLVideoElement>('.g-prev');
      if (prev && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        it.addEventListener('mouseenter', () => prev.play().then(() => prev.classList.add('is-playing')).catch(() => {}));
        it.addEventListener('mouseleave', () => { prev.classList.remove('is-playing'); prev.pause(); });
      }
    });
  }
  document.addEventListener('astro:page-load', grid);
</script>
