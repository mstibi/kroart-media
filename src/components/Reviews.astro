---
import { partners } from '../data/work';

// recenzije su prave poruke klijenata, pa ih prikazujemo kao chat, doslovno kako su poslane
const reviews = partners.filter((p) => p.quote);
---
<div class="rv-grid">
  {reviews.map((p) => (
    <figure class="rv">
      <blockquote class="rv-msgs">
        {p.quote!.lines.map((line, k) => <p class="bubble" style={`--k: ${k}`}>{line}</p>)}
      </blockquote>
      <figcaption class="rv-who">
        <span class="rv-av" aria-hidden="true">{p.quote!.author.replace(/[^\p{L}]/gu, '')}</span>
        <span class="rv-meta">
          <span class="sr-only">{p.quote!.author},</span>
          <span class="rv-name">{p.name}</span>
          <span class="rv-role">{p.quote!.role}</span>
        </span>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .rv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .rv {
    margin: 0;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    min-height: 240px; padding: 1.5rem;
    border-radius: var(--r-panel);
    background: rgba(255, 255, 255, 0.025);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.5s var(--ease-out), background-color 0.5s var(--ease-out);
  }
  .rv:hover { background: rgba(255, 255, 255, 0.04); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); }

  /* poruke stoje pri dnu, kao u razgovoru */
  .rv-msgs { margin: 0; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: 4px; }
  .bubble {
    max-width: 100%;
    padding: 0.7rem 1rem;
    border-radius: 6px 20px 20px 6px;
    background: rgba(255, 255, 255, 0.09);
    font-size: var(--t-m); line-height: 1.35; color: var(--white);
    overflow-wrap: anywhere;
  }
  .bubble:first-child { border-top-left-radius: 20px; }
  .bubble:last-child { border-bottom-left-radius: 20px; }
  .bubble:only-child { border-radius: 20px 20px 20px 6px; }
  .bubble:last-child:not(:only-child) { border-bottom-left-radius: 6px; }

  .rv-who { display: flex; align-items: center; gap: 0.75rem; }
  /* profilna kao na društvenim mrežama: inicijali u krugu */
  .rv-av {
    flex: none; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 999px;
    background: linear-gradient(145deg, #3a3a3a, #1c1c1c);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    font-size: 0.8rem; font-weight: 650; font-stretch: 110%; letter-spacing: 0.02em; color: var(--white);
  }
  .rv-meta { display: flex; flex-direction: column; line-height: 1.3; }
  .rv-name { font-size: var(--t-xs); font-weight: 600; color: var(--white); }
  .rv-role { font-size: var(--t-xs); color: var(--ash); }

  /* poruke "stižu" jedna za drugom kad sekcija uđe u kadar */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .bubble {
      opacity: 0; transform: translateY(12px) scale(0.96); transform-origin: 0 100%;
      transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out);
      transition-delay: calc(0.15s + var(--k) * 0.22s);
    }
    .rv.is-in .bubble { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .rv-grid { grid-template-columns: minmax(0, 1fr); }
    .rv { min-height: 0; }
  }
</style>

<script>
  function reviews() {
    const items = document.querySelectorAll<HTMLElement>('.rv:not(.is-in)');
    if (!items.length) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -15% 0px' });
    items.forEach((el) => io.observe(el));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', reviews);
</script>
