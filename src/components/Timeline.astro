---
// Ukrasni montažni timeline uz desni rub (naslovnica i galerije), umjesto scrollbara: ravnalo s crticama, playhead i timecode prate scroll.
// Nema navigacije ni teksta, pa je skriven čitačima ekrana i ne prima klikove.
---
<div class="tl" aria-hidden="true" data-tl>
  <div class="tl-track">
    <span class="tl-fill"></span>
    <span class="tl-head"><span class="tc tl-tc">00:00:00:00</span></span>
  </div>
</div>

<style>
  .tl {
    position: fixed; z-index: 40;
    right: 14px; top: 50%;
    width: 14px; height: min(56vh, 520px);
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-out);
  }
  /* pojavi se tek kad hero ili naslovna slika galerije ode s ekrana */
  .tl:not(.is-on) { opacity: 0; transform: translate(10px, -50%); }

  .tl-track { position: relative; height: 100%; }
  /* ravnalo: kratke crtice svakih 8 px, duže svakih 40 px, poravnate uz kičmu desno */
  .tl-track::before {
    content: ''; position: absolute; inset: 0;
    background:
      repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.3) 0 1px, transparent 1px 40px) right / 14px 100% no-repeat,
      repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.13) 0 1px, transparent 1px 8px) right / 6px 100% no-repeat;
  }
  /* kičma trake, a preko nje bijeli "odgledani" dio do playheada */
  .tl-track::after, .tl-fill {
    content: ''; position: absolute; top: 0; right: 0; width: 1px; height: 100%;
    background: rgba(255, 255, 255, 0.12);
  }
  .tl-fill { z-index: 1; background: var(--white); transform-origin: top; transform: scaleY(var(--p, 0)); }

  .tl-head {
    position: absolute; z-index: 2; top: 0; right: -4px;
    width: 22px; height: 1.5px; margin-top: -0.75px;
    background: var(--white);
    transform: translateY(var(--y, 0px));
  }
  /* glava playheada pokazuje prema traci, isti oblik kao u hero animaciji */
  .tl-head::before {
    content: ''; position: absolute; left: -7px; top: 50%;
    width: 8px; height: 9px;
    background: var(--white);
    clip-path: polygon(0 0, 55% 0, 100% 50%, 55% 100%, 0 100%);
    transform: translateY(-50%);
  }
  .tl-tc {
    position: absolute; right: calc(100% + 8px); top: 50%;
    font-size: 10px; letter-spacing: 0.08em; white-space: nowrap;
    color: var(--bone);
    transform: translateY(-50%);
  }

  /* timecode stane pored mreže tek na širokim ekranima */
  @media (max-width: 1439px) {
    .tl-tc { display: none; }
  }
  /* na uskim ekranima uz rub nema mjesta, traka bi prekrivala fotke */
  @media (max-width: 760px) {
    .tl { display: none; }
  }
</style>

<script>
  import { tcFormat } from '../scripts/timecode';

  function timeline() {
    const tl = document.querySelector<HTMLElement>('[data-tl]');
    if (!tl) return;
    const track = tl.querySelector<HTMLElement>('.tl-track')!;
    const tc = tl.querySelector<HTMLElement>('.tl-tc')!;
    const ac = new AbortController();

    const update = () => {
      const p = Math.min(1, scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight));
      tl.classList.toggle('is-on', scrollY > innerHeight * 0.4);
      tl.style.setProperty('--p', String(p));
      tl.style.setProperty('--y', `${p * track.offsetHeight}px`);
      tc.textContent = tcFormat((scrollY / innerHeight) * 2); // jedan ekran = 2 s
    };
    let raf = 0;
    const queue = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); };
    addEventListener('scroll', queue, { passive: true, signal: ac.signal });
    addEventListener('resize', queue, { signal: ac.signal });
    update();

    document.addEventListener('astro:before-swap', () => { ac.abort(); cancelAnimationFrame(raf); }, { once: true });
  }
  document.addEventListener('astro:page-load', timeline);
</script>
